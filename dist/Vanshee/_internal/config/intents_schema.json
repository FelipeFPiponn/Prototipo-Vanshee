{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "VAnsheeCommand",
    "type": "object",
    "properties": {
        "intent": {
            "type": "string",
            "enum": [
                "OPEN_APP",
                "CREATE_PROJECT",
                "RUN_SCRIPT",
                "SYSTEM_CONTROL",
                "UNKNOWN"
            ]
        },
        "target": {
            "type": "string",
            "description": "Nombre del software, servicio o comando destino."
        },
        "parameters": {
            "type": "object",
            "properties": {
                "project_type": {
                    "type": "string",
                    "enum": [
                        "python",
                        "node",
                        "react",
                        "csharp",
                        "none"
                    ]
                },
                "project_name": {
                    "type": "string"
                },
                "path": {
                    "type": "string"
                },
                "flags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "project_type"
            ]
        },
        "confidence": {
            "type": "number"
        }
    },
    "required": [
        "intent",
        "target",
        "parameters",
        "confidence"
    ]
}